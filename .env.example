# ==============================================================================
# Codemori — configuration (copie ce fichier en .env)
#   scripts/install.sh génère automatiquement les secrets ci-dessous.
# ==============================================================================

# --- Général -------------------------------------------------------------------
APP_NAME=Codemori
# Nom de domaine public. « localhost » = certificat local auto-signé (tests).
DOMAIN=localhost
PUBLIC_URL=https://localhost
HTTP_PORT=80
HTTPS_PORT=443
LOG_LEVEL=info

# --- Base de données (PostgreSQL) ---------------------------------------------
POSTGRES_DB=codemori
POSTGRES_USER=codemori
# OBLIGATOIRE — mot de passe long et aléatoire (openssl rand -hex 24)
POSTGRES_PASSWORD=

# --- Comptes -------------------------------------------------------------------
# Compte administrateur créé (ou promu) au démarrage. Sans cela, le premier
# compte inscrit devient administrateur.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# false = seules les personnes ayant déjà un compte peuvent se connecter
ALLOW_REGISTRATION=true
SESSION_DAYS=30
# Cookies « Secure » (HTTPS). Mettre false uniquement pour un accès HTTP local.
COOKIE_SECURE=true

# --- Exécution du code ---------------------------------------------------------
# OBLIGATOIRE — jeton partagé entre l'application et le runner (openssl rand -hex 32)
RUNNER_TOKEN=
# Nombre de compilations simultanées (≈ nombre de cœurs disponibles)
RUNNER_MAX_PARALLEL=4
RUNNER_MAX_QUEUE=50
# CPU alloués à chaque bac à sable
RUNNER_CPUS=1
RUNNER_MEMORY_RUST=512m
RUNNER_MEMORY_CPP=384m
RUNNER_MEMORY_JAVA=640m
# Runtime d'isolation renforcée optionnel (gVisor installé sur l'hôte : runsc)
RUNNER_DOCKER_RUNTIME=
# Exécutions autorisées par utilisateur et par minute
RUN_LIMIT_PER_MINUTE=20

# --- Contenu pédagogique --------------------------------------------------------
# Importe content/ au démarrage (les éléments modifiés dans l'admin sont préservés)
CONTENT_AUTO_IMPORT=true

# --- Assistant IA (facultatif) -------------------------------------------------
# none   : assistant pédagogique intégré, sans IA externe (par défaut)
# openai : toute API compatible OpenAI (OpenAI, Mistral, Groq, LM Studio, vLLM…)
# ollama : modèle local (docker compose --profile ai up -d, puis
#          docker compose exec ollama ollama pull qwen2.5-coder:7b)
AI_PROVIDER=none
# openai : https://api.openai.com/v1  — ollama : http://ollama:11434
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ------------------------------------------------------------------------------
# Sécurité : clé de chiffrement des secrets de double authentification.
# Génère-la une fois (openssl rand -hex 32) et ne la change plus.
# Vide = dérivée de RUNNER_TOKEN.
APP_SECRET=

# ------------------------------------------------------------------------------
# Paiements (facultatif) — voir docs/monetisation.md
# Boutique de clés : STRIPE_SECRET_KEY suffit. Abonnement mensuel : + STRIPE_PRICE_ID.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Publicités : house (annonces maison, sans revenu) ou adsense (rémunérées par Google)
ADS_PROVIDER=house
ADSENSE_CLIENT=
ADSENSE_SLOT_REWARD=
ADSENSE_SLOT_BANNER=

# ------------------------------------------------------------------------------
# E-mails (vérification d'adresse obligatoire à l'inscription, mot de passe oublié)
# Sans SMTP, la vérification n'est pas imposée. Exemples : Brevo, Mailjet, Gmail
# (mot de passe d'application), le SMTP de ton fournisseur d'accès…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Codemori <no-reply@ton-domaine.fr>
REQUIRE_EMAIL_VERIFICATION=true

# Connexion avec Google / Facebook (gratuit ; nécessite une adresse publique en HTTPS)
# URL de redirection à déclarer : <PUBLIC_URL>/api/auth/oauth/google/callback (idem facebook)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

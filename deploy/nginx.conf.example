# Alternative à Caddy : configuration Nginx (à placer dans /etc/nginx/sites-available/).
# Les certificats sont obtenus séparément, par exemple avec certbot :
#   certbot certonly --webroot -w /var/www/certbot -d codemori.mondomaine.fr
# Dans ce cas, publie le port de l'application (ex. "127.0.0.1:4000:4000" dans
# docker-compose.override.yml) et désactive le service caddy.

server {
    listen 80;
    listen [::]:80;
    server_name codemori.mondomaine.fr;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name codemori.mondomaine.fr;

    ssl_certificate     /etc/letsencrypt/live/codemori.mondomaine.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/codemori.mondomaine.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    client_max_body_size 2m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /assets/ {
        proxy_pass http://127.0.0.1:4000;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # compilations longues
    }
}
